@@ -6,5 +6,48 @@ frappe.ui.form.on("Insights Table Import Job", {
 		frm.add_custom_button(__("Enqueue"), () => {
 			frm.call("enqueue");
 		});
+
+		frm.add_custom_button(__("Bulk Enqueue"), () => {
+			frappe.prompt(
+				{
+					fieldname: "run_count",
+					fieldtype: "Int",
+					label: "Number of Runs",
+					reqd: 1,
+					default: 1,
+				},
+				(values) => {
+					frm.call("bulk_enqueue", { run_count: values.run_count });
+
+					// Show progress indicator
+					frappe.show_progress(
+						__("Bulk Enqueue Progress"),
+						0,
+						values.run_count,
+						__("Starting..."),
+					);
+
+					// Listen for realtime progress updates
+					frappe.realtime.on("bulk_enqueue_progress", (data) => {
+						if (data.job === frm.doc.name) {
+							frappe.show_progress(
+								__("Bulk Enqueue Progress"),
+								data.current,
+								data.total,
+								__("Run {0} of {1}", [
+									data.current,
+									data.total,
+								]),
+							);
+							if (data.current === data.total) {
+								setTimeout(() => frappe.hide_progress(), 1000);
+								frm.reload_doc();
+							}
+						}
+					});
+				},
+				__("Bulk Enqueue Import Job"),
+			);
+		});
 	},
 });
diff --git a/insights/insights/doctype/insights_table_import_job/insights_table_import_job.py b/insights/insights/doctype/insights_table_import_job/insights_table_import_job.py
